# ╔══════════════════════════════════════════════════════════════════════════╗
# ║  PRODUCTION SOZLAMALARI                                                  ║
# ║                                                                          ║
# ║  Bu faylni GIT'GA QO'YMANG. Qiymatlarni Railway/Vercel panelidagi        ║
# ║  "Variables" bo'limiga ko'chiring.                                       ║
# ║                                                                          ║
# ║  <TO'LDIRING> deb belgilangan joylar sizdan kutilmoqda.                  ║
# ╚══════════════════════════════════════════════════════════════════════════╝

NODE_ENV="production"

# ─── SUPABASE ────────────────────────────────────────────────────────────────
# .env dagi bilan bir xil. Parolni PRODUCTION uchun ALMASHTIRING — hozirgisi
# suhbat tarixiga tushgan.
DATABASE_URL="<TO'LDIRING — pooler, port 6543, connection_limit=10>"
DIRECT_URL="<TO'LDIRING — port 5432>"

# ─── AUTH — yangi generatsiya qilindi, boshqa hech qayerda ishlatilmagan ────
JWT_SECRET="..."
JWT_REFRESH_SECRET="..."

# O'yin akkauntlari uchun shifrlash kaliti (AES-256-GCM).
# ⚠️  O'ZGARTIRMANG — almashtirilsa sotilgan akkauntlar ochilmay qoladi.
CREDENTIALS_SECRET="..."
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"

# ─── SERVER ──────────────────────────────────────────────────────────────────
API_PORT="3001"
API_HOST="0.0.0.0"
# Vercel manzilingiz. Bu YERGA to'g'ri yozilmasa brauzer so'rovlarni bloklaydi.
CORS_ORIGINS="<TO'LDIRING — https://sizning-sayt.vercel.app>"

# ─── TO'LOV — CLICK (HAQIQIY PUL) ────────────────────────────────────────────
#
# To'rt qiymat ham merchant.click.uz kabinetidan olinadi.
# Bittasi bo'sh qolsa server ISHGA TUSHMAYDI — bu ataylab shunday:
# yarim sozlangan to'lov tizimi eng xavfli holat.
PAYMENT_PROVIDER="click"

CLICK_SERVICE_ID="..."
CLICK_MERCHANT_ID="..."
# ⚠️ Callback imzosini shu kalit tekshiradi. Sizib chiqsa — istalgan odam
#    "pul keldi" deb yuborib, pulsiz savdolarni to'langan qila oladi.
CLICK_SECRET_KEY="..."
CLICK_MERCHANT_USER_ID="..."

# ─── CLICK KABINETIGA KIRITILADIGAN MANZILLAR ────────────────────────────────
# Bu qiymatlar .env ga EMAS, merchant.click.uz kabinetiga yoziladi:
#
#   Prepare URL  :  https://sizning-api.up.railway.app/webhooks/click/prepare
#   Complete URL :  https://sizning-api.up.railway.app/webhooks/click/complete
#
# Ikkalasi ham HTTPS bo'lishi shart.

# ─── EMAIL ───────────────────────────────────────────────────────────────────
EMAIL_DRIVER="smtp"
EMAIL_FROM="ishonchli.uz <sizning-gmail@gmail.com>"
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="<TO'LDIRING — sizning-gmail@gmail.com>"
# ⚠️ Gmail'ning ODDIY paroli EMAS. "App Password" kerak — quyida tushuntirilgan.
SMTP_PASSWORD="<TO'LDIRING — 16 belgili App Password>"

# ─── ADMIN ───────────────────────────────────────────────────────────────────
# `npm run db:seed` shu ma'lumot bilan BITTA admin yaratadi. Demo
# foydalanuvchilar yaratilmaydi.
SEED_ADMIN_EMAIL="<TO'LDIRING — sizning email>"
# ⚠️ Bu parol suhbat tarixiga tushgan. Deploy'dan OLDIN o'zingiznikiga
#    almashtiring — seed zaif parollarni production'da rad etadi.
SEED_ADMIN_PASSWORD="<TO'LDIRING — kuchli parol>"

# ─── FAYL SAQLASH ────────────────────────────────────────────────────────────
STORAGE_DRIVER="local"
STORAGE_LOCAL_PATH="./storage/uploads"

# ─────────────────────────────────────────────────────────────────────────────
# FRONTEND — bu o'zgaruvchi VERCEL panelida beriladi, Railway'da EMAS
# ─────────────────────────────────────────────────────────────────────────────
# Railway bergan API manzili. Oxirida "/" QO'YMANG.
NEXT_PUBLIC_API_URL="..."
