# ─────────────────────────────────────────────────────────────────────────────
# SUPABASE — POSTGRESQL
#
# Supabase panelida: Project Settings → Database → Connection string
# IKKALASI HAM kerak:
#
#   DATABASE_URL — "Transaction pooler" (port 6543). Ilova ish vaqtida ishlatadi.
#                  Oxiriga ?pgbouncer=true&connection_limit=1 qo'shish SHART.
#   DIRECT_URL   — "Direct connection" (port 5432). Faqat migratsiyalar uchun.
#                  Pgbouncer orqali `prisma migrate` ishlamaydi.
# ─────────────────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres.<project-ref>:<PAROL>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.<project-ref>:<PAROL>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# ─────────────────────────────────────────────────────────────────────────────
# REDIS — BullMQ fon vazifalari (faqat 7-bosqichdan boshlab kerak)
# Upstash yoki lokal Redis. Bo'sh qoldirilsa fon vazifalari o'chiriladi.
# ─────────────────────────────────────────────────────────────────────────────
REDIS_URL=""

# ─────────────────────────────────────────────────────────────────────────────
# AUTH
# JWT_SECRET va JWT_REFRESH_SECRET har xil bo'lishi SHART.
# Yaratish:  openssl rand -base64 48
# ─────────────────────────────────────────────────────────────────────────────
JWT_SECRET="<openssl rand -base64 48>"
JWT_REFRESH_SECRET="<openssl rand -base64 48 — yuqoridagidan BOSHQA>"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"

# ─────────────────────────────────────────────────────────────────────────────
# SERVER
# ─────────────────────────────────────────────────────────────────────────────
NODE_ENV="development"
API_PORT="3001"
API_HOST="0.0.0.0"
# Vergul bilan ajratilgan ro'yxat. `*` ishlatish TAQIQLANADI (§11).
CORS_ORIGINS="http://localhost:3000"

# ─────────────────────────────────────────────────────────────────────────────
# TO'LOV PROVAYDERI
# mock        — "To'ladim" tugmasi bilan test rejimi (MVP, barcha testlar)
# checkout_uz — haqiqiy integratsiya
# ─────────────────────────────────────────────────────────────────────────────
PAYMENT_PROVIDER="mock"

# checkout.uz — https://checkout.uz/api-docs
# Autentifikatsiya faqat API kalit orqali (Authorization: Bearer <key>).
CHECKOUT_UZ_BASE_URL="https://checkout.uz/api/v1"
CHECKOUT_UZ_API_KEY=""

# ⚠️ checkout.uz'da sandbox YO'Q — har qanday to'lov haqiqiy pul.
# "production" qilinmaguncha checkout_uz provayderi ishga tushmaydi.
CHECKOUT_UZ_ENV="sandbox"

# BIZNING serverimiz manzili — checkout.uz shu yerga xabar yuboradi.
# Lokal: npx cloudflared tunnel --url http://localhost:3001
CHECKOUT_UZ_WEBHOOK_URL=""

# ─────────────────────────────────────────────────────────────────────────────
# FAYL SAQLASH
# local — lokal disk (MVP). s3 — keyingi bosqich.
# ─────────────────────────────────────────────────────────────────────────────
STORAGE_DRIVER="local"
STORAGE_LOCAL_PATH="./storage/uploads"

# ─────────────────────────────────────────────────────────────────────────────
# SEED — boshlang'ich admin hisobi (faqat development)
# ─────────────────────────────────────────────────────────────────────────────
SEED_ADMIN_EMAIL="admin@escrow.uz"
SEED_ADMIN_PASSWORD=""

# ─────────────────────────────────────────────────────────────────────────────
# FRONTEND
# ─────────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL="http://localhost:3001"

# ─── EMAIL XABARNOMALARI ─────────────────────────────────────────────────────
EMAIL_DRIVER="log"        # log | smtp
EMAIL_FROM="Escrow.uz <noreply@escrow.uz>"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
