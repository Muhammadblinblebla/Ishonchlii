# ─────────────────────────────────────────────────────────────────────────────
# SUPABASE — POSTGRESQL
#
# Supabase panelida: Project Settings → Database → Connection string
# IKKALASI HAM kerak:
#
#   DATABASE_URL — "Transaction pooler" (port 6543). Ilova ish vaqtida ishlatadi.
#                  Oxiriga ?pgbouncer=true&connection_limit=10&pool_timeout=20 qo'shish SHART.
#   DIRECT_URL   — "Direct connection" (port 5432). Faqat migratsiyalar uchun.
#                  Pgbouncer orqali `prisma migrate` ishlamaydi.
# ─────────────────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres.<project-ref>:<PAROL>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=10&pool_timeout=20"
DIRECT_URL="postgresql://postgres.<project-ref>:<PAROL>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# ─────────────────────────────────────────────────────────────────────────────
# REDIS — BullMQ fon vazifalari (faqat 7-bosqichdan boshlab kerak)
# Upstash yoki lokal Redis. Bo'sh qoldirilsa fon vazifalari o'chiriladi.
# ─────────────────────────────────────────────────────────────────────────────
REDIS_URL=""

# ─────────────────────────────────────────────────────────────────────────────
# AUTH
# JWT_SECRET va JWT_REFRESH_SECRET har xil bo'lishi SHART.
# Yaratish:  openssl rand -base64 48
# ─────────────────────────────────────────────────────────────────────────────
JWT_SECRET="<openssl rand -base64 48>"
JWT_REFRESH_SECRET="<openssl rand -base64 48 — yuqoridagidan BOSHQA>"
# O'yin akkauntlari login/parolini shifrlash kaliti (AES-256-GCM).
# ⚠️ Bir marta o'rnatiladi va HECH QACHON o'zgartirilmaydi: kalit almashsa
#    allaqachon sotilgan akkauntlarning parollarini ochib bo'lmaydi.
#    JWT sirlaridan FARQ QILISHI shart.
CREDENTIALS_SECRET="<openssl rand -base64 48 — JWT sirlaridan BOSHQA>"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"

# ─────────────────────────────────────────────────────────────────────────────
# SERVER
# ─────────────────────────────────────────────────────────────────────────────
NODE_ENV="development"
API_PORT="3001"
API_HOST="0.0.0.0"
# Vergul bilan ajratilgan ro'yxat. `*` ishlatish TAQIQLANADI (§11).
CORS_ORIGINS="http://localhost:3000"

# ─────────────────────────────────────────────────────────────────────────────
# TO'LOV PROVAYDERI
# mock        — "To'ladim" tugmasi bilan test rejimi (barcha testlar shuni ishlatadi)
# click       — Click SHOP API (production)
# checkout_uz — eski integratsiya, hozir ishlatilmaydi
# ─────────────────────────────────────────────────────────────────────────────
PAYMENT_PROVIDER="mock"

# ─── CLICK ───────────────────────────────────────────────────────────────────
# To'rt qiymat ham merchant.click.uz kabinetidan olinadi.
# PAYMENT_PROVIDER="click" bo'lsa TO'RTTASI HAM to'ldirilgan bo'lishi shart,
# aks holda server ishga tushmaydi.
CLICK_SERVICE_ID=""
CLICK_MERCHANT_ID=""
# ⚠️ Callback imzosini shu kalit tekshiradi — sirdek saqlang.
CLICK_SECRET_KEY=""
CLICK_MERCHANT_USER_ID=""

# Bu manzillar .env ga EMAS, Click KABINETIGA kiritiladi:
#   Prepare  : https://<api-manzilingiz>/webhooks/click/prepare
#   Complete : https://<api-manzilingiz>/webhooks/click/complete
# Lokal sinash uchun tunnel: npx cloudflared tunnel --url http://localhost:3001

# ─── checkout.uz (eski) ──────────────────────────────────────────────────────
CHECKOUT_UZ_BASE_URL="https://checkout.uz/api/v1"
CHECKOUT_UZ_API_KEY=""
CHECKOUT_UZ_ENV="sandbox"
CHECKOUT_UZ_WEBHOOK_URL=""

# ─────────────────────────────────────────────────────────────────────────────
# FAYL SAQLASH
# local — lokal disk (MVP). s3 — keyingi bosqich.
# ─────────────────────────────────────────────────────────────────────────────
STORAGE_DRIVER="local"
STORAGE_LOCAL_PATH="./storage/uploads"

# ─────────────────────────────────────────────────────────────────────────────
# SEED — boshlang'ich admin hisobi (faqat development)
# ─────────────────────────────────────────────────────────────────────────────
SEED_ADMIN_EMAIL="admin@ishonchli.uz"
SEED_ADMIN_PASSWORD=""

# ─────────────────────────────────────────────────────────────────────────────
# FRONTEND
# ─────────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL="http://localhost:3001"

# ─── EMAIL XABARNOMALARI ─────────────────────────────────────────────────────
EMAIL_DRIVER="log"        # log | smtp
EMAIL_FROM="ishonchli.uz <noreply@ishonchli.uz>"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
