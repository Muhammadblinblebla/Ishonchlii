{
  "name": "@escrowuz/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -b",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "ledger:check": "tsx scripts/check-ledger.ts",
    "db:verify": "tsx scripts/verify-schema.ts",
    "db:reset": "tsx scripts/reset-production.ts"
  },
  "dependencies": {
    "@escrowuz/shared": "*",
    "@fastify/cors": "^10.0.1",
    "@fastify/helmet": "^13.0.0",
    "@fastify/multipart": "^9.0.1",
    "@fastify/rate-limit": "^10.2.1",
    "@prisma/client": "^6.1.0",
    "@types/nodemailer": "^8.0.1",
    "argon2": "^0.41.1",
    "fastify": "^5.2.0",
    "fastify-plugin": "^5.0.1",
    "file-type": "^22.0.1",
    "jose": "^5.9.6",
    "nodemailer": "^9.0.3",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/supertest": "^6.0.2",
    "prisma": "^6.1.0",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^4.1.10"
  }
}
